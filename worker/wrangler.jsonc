// Cloudflare Worker config for the telemetry-collection endpoint.
// Deploy: npx wrangler deploy   Local dev: npx wrangler dev (emulated R2,
// secrets from .dev.vars).
//
// Auth is open by default (client-generated tokens). Optional secrets, both
// set with `npx wrangler secret put <NAME>` — never in this file:
//   BLOCKLIST  JSON array of banned sender ids, e.g. ["a3f9c2e811d04b57"]
//   TOKENS     JSON {"<token>":"<sender-id>"} — setting it flips the endpoint
//              to allowlist-only mode (the abuse circuit breaker)
{
  "name": "tuners-collect",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "r2_buckets": [
    { "binding": "BUNDLES", "bucket_name": "tuners-bundles" }
  ],
  "vars": {
    "MAX_BUNDLE_MB": "64",
    "DAILY_CAP_MB": "512",
    // Hard ceiling on total bucket size: hostile uploads can pin storage at
    // this worst case (~$0.15/mo over the free 10 GB) but never grow it.
    "GLOBAL_CAP_GB": "20"
  },
  // Platform rate limiter: consulted but measured NON-ENFORCING on this
  // account (2026-07-25/26, always success:true under 8x sustained load,
  // fresh namespace) — the enforced throttle is in-isolate in index.js.
  // Kept so enforcement is honored if the binding ever starts counting.
  "ratelimits": [
    { "name": "IP_LIMIT", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } }
  ],
  // No per-request logs retained: the plan's "nothing about the sender
  // beyond the token" promise.
  "observability": { "enabled": false }
}
